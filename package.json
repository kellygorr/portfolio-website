{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n site,storybook -c blue,magenta \"npm:dev:site\" \"npm:storybook\"",
    "dev:site": "vite",
    "dev:text-adventure": "npm --prefix websites/text-adventure-on-rails start",
    "build": "tsc && vite build && npm run build:websites",
    "build:storybook": "storybook build -o dist/storybook",
    "build:websites": "node scripts/build-websites.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:copy": "node scripts/lint-copy.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "assets:push": "aws s3 sync src/assets/images s3://kellygorr.com/source-assets/images --region us-west-1 --exclude .DS_Store && aws s3 sync src/assets/thumbnails s3://kellygorr.com/source-assets/thumbnails --region us-west-1 --exclude .DS_Store && aws s3 sync src/assets/videos s3://kellygorr.com/source-assets/videos --region us-west-1 --exclude .DS_Store",
    "assets:pull": "aws s3 sync s3://kellygorr.com/source-assets/images src/assets/images --region us-west-1 && aws s3 sync s3://kellygorr.com/source-assets/thumbnails src/assets/thumbnails --region us-west-1 && aws s3 sync s3://kellygorr.com/source-assets/videos src/assets/videos --region us-west-1",
    "prepare": "husky"
  },
  "dependencies": {
    "@fluentui-copilot/react-copilot": "^0.30.5",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.343",
    "@fluentui/react-motion": "^9.16.4",
    "localforage": "^1.10.0",
    "match-sorter": "^6.3.4",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intersection-observer": "^9.8.1",
    "react-router-dom": "^6.22.2",
    "sort-by": "^1.2.0",
    "styled-components": "^6.1.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^20.11.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^10.6.0",
    "husky": "^9.1.7",
    "prettier": "3.2.5",
    "storybook": "^10.6.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  }
}
